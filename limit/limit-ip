#!/bin/bash
# Safe Multi-Login Monitor (Notify-Only: tidak menghapus akun & tidak merestart Xray)

ACCESS_LOG="/var/log/xray/access.log"
COOLDOWN_SECS=600

send_log() {
    local proto="$1"
    local user="$2"
    local count="$3"
    local limit="$4"
    local ips="$5"
    local chatid key url text

    chatid=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 3)
    key=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 2)
    [[ -z "$chatid" || -z "$key" ]] && return 0

    url="https://api.telegram.org/bot${key}/sendMessage"
    text="
<code>────────────────────</code>
<b>⚠️ NOTIFICATIONS MULTI LOGIN ⚠️</b>
<code>────────────────────</code>
<code>Protocol  : </code><code>${proto}</code>
<code>Username  : </code><code>${user}</code>
<code>IP Aktif  : </code><code>${count} / ${limit}</code>
<code>Daftar IP : </code>
<code>${ips}</code>
<code>────────────────────</code>"
    curl -s --max-time 10 -d "chat_id=${chatid}&disable_web_page_preview=1&text=${text}&parse_mode=html" "$url" >/dev/null 2>&1 || true
}

check_protocol() {
    local proto="$1"
    local limit_dir="$2"

    sleep 60
    [[ -d "$limit_dir" && -r "$ACCESS_LOG" ]] || return 0

    local recent_log
    recent_log=$(tail -n 5000 "$ACCESS_LOG" 2>/dev/null)
    [[ -z "$recent_log" ]] && return 0

    local now
    now=$(date +%s)

    for limit_file in "$limit_dir"/*; do
        [[ -f "$limit_file" ]] || continue
        local user iplimit ips cekcek stamp_file last_ts
        user=$(basename "$limit_file")
        iplimit=$(tr -dc '0-9' < "$limit_file")
        [[ -z "$iplimit" || "$iplimit" -le 0 ]] && continue

        # Cocokkan tepat "email: <user>" di akhir baris, abaikan 127.0.0.1
        ips=$(printf '%s\n' "$recent_log" \
            | awk -v u="$user" '$0 ~ ("email: " u "$") { ip=$3; sub(/^tcp:/, "", ip); sub(/:[0-9]+$/, "", ip); if (ip != "" && ip != "127.0.0.1") print ip }' \
            | sort -u)

        if [[ -z "$ips" ]]; then
            cekcek=0
        else
            cekcek=$(printf '%s\n' "$ips" | wc -l)
        fi

        if [[ "$cekcek" -gt "$iplimit" ]]; then
            stamp_file="/tmp/.limitip-alert-${proto}-${user}"
            last_ts=$(cat "$stamp_file" 2>/dev/null || echo 0)
            if (( now - last_ts >= COOLDOWN_SECS )); then
                echo "$now" > "$stamp_file"
                send_log "$proto" "$user" "$cekcek" "$iplimit" "$ips"
            fi
        fi
    done
}

case "${1:-}" in
    vmip) check_protocol "VMess"  "/etc/kyt/limit/vmess/ip" ;;
    vlip) check_protocol "VLESS"  "/etc/kyt/limit/vless/ip" ;;
    trip) check_protocol "Trojan" "/etc/kyt/limit/trojan/ip" ;;
esac
