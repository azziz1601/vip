[Unit]
Description=Xray-Lite (High-Performance Rust Xray Server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xray-lite run -c /etc/xray/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
LimitNOFILE=65536
Nice=-5

[Install]
WantedBy=multi-user.target
